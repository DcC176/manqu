{
  "manifest_version": 3,
  "name": "满区",
  "version": "1.0.0",
  "description": "识别直播间重复弹幕（独轮车），在画面本地叠加模拟弹幕增强氛围。仅在本机渲染，不会发送任何弹幕，不发起任何网络请求。",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://live.bilibili.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://live.bilibili.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "独轮车增噪",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
